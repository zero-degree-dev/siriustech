{
  "name": "siriustech",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 0.0.0.0",
    "dev:services": "node scripts/dev.mjs --services-only",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backend:dev": "bun run --filter @siriustech/backend dev",
    "backend:build": "bun run --filter @siriustech/backend build",
    "backend:start": "bun run --filter @siriustech/backend start",
    "db:migrate": "bun run --filter @siriustech/backend db:migrate",
    "db:seed": "bun run --filter @siriustech/backend db:seed",
    "db:setup": "bun run backend:build && bun run db:migrate && bun run db:seed",
    "db:local": "node scripts/local-postgres.mjs",
    "test:backend": "bun run --filter @siriustech/backend test",
    "mcp": "bun run --filter @siriustech/backend mcp"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "next": "16.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5",
    "@fontsource-variable/jetbrains-mono": "^5",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/roboto": "^5",
    "@playwright/test": "^1.58",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^26",
    "stylelint": "^16",
    "stylelint-config-standard": "^38",
    "typescript": "^5.9.3",
    "vitest": "^3"
  },
  "trustedDependencies": [
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-ia32",
    "@embedded-postgres/linux-ppc64",
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/windows-x64"
  ],
  "workspaces": [
    "backend"
  ]
}
